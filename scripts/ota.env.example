# Copy to scripts/ota.env and adjust. Sourced by scripts/ota-publish.sh.
# FTP host/user/pass are reused from .ftp-credentials — only the OTA subdomain
# docroot path on the FTP server is configured here. (scripts/ota.env is gitignored.)

# Docroot of the ota.cryptocalk.com subdomain, relative to the FTP home dir.
# Confirm the exact path in your hosting panel after creating the subdomain
# (Plesk typically: ota.cryptocalk.com/httpdocs).
OTA_FTP_DIR="ota.cryptocalk.com/httpdocs"
