---
// Google AdMob — NATIVE ANDROID ONLY.
// On the public website and on iOS this is a no-op and the @capacitor-community/admob chunk is
// never fetched. iOS stays gated off until a real iOS AdMob app ID + ad units exist (Info.plist
// currently has a placeholder app ID purely so the Google Mobile Ads SDK won't crash on launch).
//
// UMP consent (added 2026-08-25). Until now the app called AdMob.initialize() and showed a banner
// with no consent step at all, so EEA/UK users were served ads without ever being asked. The cookie
// banner never covered this — it only drove gtag consent, and GA/AdSense do not run in the app.
// The UMP SDK is already inside the shipped binary (verified in the June AAB: 31 references to
// com/google/android/ump), so this ships over OTA without a new release.
import type { Lang } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props as Props;

const PRIVACY_LABEL: Record<string, string> = {
  en: 'Ad privacy settings',
  es: 'Configuración de privacidad de anuncios',
  pt: 'Configurações de privacidade de anúncios',
  tr: 'Reklam gizliliği ayarları',
  hi: 'विज्ञापन गोपनीयता सेटिंग्स',
  ru: 'Настройки приватности рекламы',
};
const privacyLabel = PRIVACY_LABEL[lang as string] ?? PRIVACY_LABEL.en;
---

<!-- Ongoing consent entry point. Google requires a persistent way to change consent wherever the
     privacy options form is required; it stays hidden everywhere else, including the website. -->
<button type="button" id="cc-ad-privacy" class="cc-ad-privacy" hidden>{privacyLabel}</button>

<script>
  (async () => {
    const cap = (window as any).Capacitor;
    if (cap?.getPlatform?.() !== 'android') return; // web + iOS: no ads, no consent form

    const BANNER_ID = 'ca-app-pub-4859241862365215/5286587474';
    const INTERSTITIAL_ID = 'ca-app-pub-4859241862365215/3290979529';

    // Re-apply the banner's reserved space on each page load so content isn't covered by it.
    const savedH = sessionStorage.getItem('cc_banner_h');
    if (savedH) document.body.style.paddingBottom = savedH + 'px';

    try {
      const { AdMob, BannerAdSize, BannerAdPosition, BannerAdPluginEvents } =
        await import('@capacitor-community/admob');

      // ── Consent FIRST. No ad may be requested before this resolves. ──────────────
      let canRequestAds = false;
      let privacyOptionsRequired = false;
      try {
        let info = await AdMob.requestConsentInfo();
        // Only shown where a message applies (EEA/UK) AND a GDPR message is published in the
        // AdMob console. Outside those regions status comes back NOT_REQUIRED and nothing appears.
        if (info.isConsentFormAvailable && info.status === 'REQUIRED') {
          info = await AdMob.showConsentForm();
        }
        canRequestAds = info.canRequestAds !== false;
        privacyOptionsRequired = info.privacyOptionsRequirementStatus === 'REQUIRED';
      } catch {
        // UMP could not resolve (offline, or no message published yet). We deliberately do NOT
        // fall through to serving ads: the app has no cached grant to rely on, and showing ads to
        // a possibly-EEA user without consent is exactly the risk this code exists to remove.
        // Cost of being wrong here is one session without ads; the other way round it is a breach.
        canRequestAds = false;
      }

      // Wire up the ongoing entry point regardless of whether ads run this session.
      const privacyBtn = document.getElementById('cc-ad-privacy');
      if (privacyBtn && privacyOptionsRequired) {
        privacyBtn.hidden = false;
        privacyBtn.addEventListener('click', () => {
          AdMob.showPrivacyOptionsForm().catch(() => { /* form unavailable — leave the app alone */ });
        });
      }

      if (!canRequestAds) return; // no consent → no ads. Intentional.

      await AdMob.initialize();

      // Reserve space equal to the banner height (fires once the banner lays out).
      AdMob.addListener(BannerAdPluginEvents.SizeChanged, (info: any) => {
        const h = info && info.height ? info.height : 0;
        sessionStorage.setItem('cc_banner_h', String(h));
        document.body.style.paddingBottom = h + 'px';
      });

      // Bottom banner — shown once per app session; the native banner persists across in-app
      // page navigations, so we don't re-request it on every page load.
      if (!sessionStorage.getItem('cc_banner')) {
        sessionStorage.setItem('cc_banner', '1');
        await AdMob.showBanner({
          adId: BANNER_ID,
          adSize: BannerAdSize.ADAPTIVE_BANNER,
          position: BannerAdPosition.BOTTOM_CENTER,
          margin: 0,
        });
      }

      // Interstitial — conservative cadence: every 6th navigation, never in the first 2 of a
      // session, and min 120s apart. Keeps within AdMob's interstitial frequency policy.
      const nav = parseInt(localStorage.getItem('cc_nav') || '0', 10) + 1;
      localStorage.setItem('cc_nav', String(nav));
      const sNav = parseInt(sessionStorage.getItem('cc_snav') || '0', 10) + 1;
      sessionStorage.setItem('cc_snav', String(sNav));
      const last = parseInt(localStorage.getItem('cc_int_ts') || '0', 10);
      const now = Date.now();
      if (sNav > 2 && nav % 6 === 0 && now - last > 120000) {
        try {
          await AdMob.prepareInterstitial({ adId: INTERSTITIAL_ID });
          await AdMob.showInterstitial();
          localStorage.setItem('cc_int_ts', String(now));
        } catch { /* not ready / no fill — skip this time */ }
      }
    } catch {
      /* plugin unavailable on this build — ignore */
    }
  })();
</script>

<style>
  .cc-ad-privacy {
    display: block;
    margin: 0 auto 28px;
    padding: 8px 16px;
    font: inherit;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    min-height: 44px;
  }

  .cc-ad-privacy[hidden] {
    display: none;
  }

  .cc-ad-privacy:hover,
  .cc-ad-privacy:focus-visible {
    color: var(--color-primary-text, var(--color-primary));
    border-color: currentColor;
  }
</style>
