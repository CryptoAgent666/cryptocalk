---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import type { Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return ['es', 'pt', 'tr', 'hi', 'ru'].map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };

interface UpdateEntry {
  date: string;
  dateLabel: string;
  title: string;
  body: string;
  items?: string[];
  cta?: { text: string; href: string };
  footer?: string;
}

interface UpdatesContent {
  pageTitle: string;
  metaDescription: string;
  heading: string;
  subtitle: string;
  updates: UpdateEntry[];
}

const content: Record<Exclude<Lang, 'en'>, UpdatesContent> = {
  es: {
    pageTitle: 'Novedades — CryptoCalk',
    metaDescription: 'Descubre las novedades de CryptoCalk — nuevas calculadoras, funciones y mejoras en nuestra suite gratuita de herramientas crypto.',
    heading: 'Novedades',
    subtitle: 'Últimas actualizaciones, nuevas calculadoras y mejoras en CryptoCalk.',
    updates: [
      {
        date: '2026-10-13',
        dateLabel: '13 de octubre de 2026',
        title: 'Calculadoras de minería: vuelven los datos de red en vivo',
