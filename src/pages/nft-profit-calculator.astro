  title="NFT Profit Calculator — OpenSea, Blur, Magic Eden Fees"
  description="Free NFT profit calculator. See your real profit in ETH and USD after marketplace fees (OpenSea, Blur, Magic Eden presets), creator royalties and gas, plus the break-even price."
  lang="en"
  pageType="calculator"
  dateModified={lastReviewedISO}
>
