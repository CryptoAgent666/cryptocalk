{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cryptocalk",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "cryptocalk-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist"
      ],
      "port": 4322,
      "autoPort": true
    },
    {
      "name": "cryptocalk-worker",
      "runtimeExecutable": "wrangler",
      "runtimeArgs": [
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    }
  ]
}
