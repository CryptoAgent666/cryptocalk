{
  "name": "cryptocalk",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-platform-files.mjs",
    "preview": "astro preview",
    "verify:slug-migration": "node scripts/verify-slug-migration.mjs",
    "verify:localized-styles": "node scripts/verify-localized-styles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:check": "npm run test && npm run build && npm run verify:slug-migration && npm run verify:localized-styles",
    "astro": "astro",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "ipa": "bash scripts/build-ipa.sh",
    "ota:publish": "bash scripts/ota-publish.sh"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capgo/capacitor-updater": "^8.49.1",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
